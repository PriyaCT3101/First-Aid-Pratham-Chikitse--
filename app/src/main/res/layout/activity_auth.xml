<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_soft"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_first_aid" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="@string/auth_title"
        android:textColor="@color/ink"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/auth_subtitle"
        android:textColor="@color/muted"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/etPhone"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_input"
        android:hint="@string/phone_hint"
        android:inputType="phone"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/muted" />

    <Button
        android:id="@+id/btnGetOtp"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/brand_green"
        android:text="@string/get_otp"
        android:textColor="@color/white" />

    <EditText
        android:id="@+id/etOtp"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_input"
        android:hint="@string/otp_hint"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/muted"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnVerify"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/brand_green_dark"
        android:text="@string/verify_access"
        android:textColor="@color/white"
        android:visibility="gone" />
</LinearLayout>
