<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvHospitalName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ink"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHospitalAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_badge_soft"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/brand_green"
        android:textSize="13sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#F0F0F0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCall"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1.2"
            app:backgroundTint="@color/brand_green"
            android:paddingHorizontal="8dp"
            android:text="CALL"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:icon="@android:drawable/ic_menu_call"
            app:iconPadding="4dp"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavigate"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            app:backgroundTint="#1976D2"
            android:text="NAVIGATE"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:icon="@android:drawable/ic_menu_directions"
            app:iconPadding="4dp"
            app:iconGravity="textStart" />
    </LinearLayout>

    <!-- Hidden textview to maintain compatibility with existing adapter if needed, though we will update adapter -->
    <TextView
        android:id="@+id/tvHospitalPhone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
